{
  // Nommage « Catégorie : ce que ça fait ». VS Code trie par ordre
  // alphabétique, donc le préfixe regroupe. Le `detail` tient en une ligne :
  // ce que ça produit, et combien de temps ça prend.
  // Vue d'ensemble et explications : voir notes.md, section « Tâches VS Code ».
  "version": "2.0.0",
  "tasks": [
    // ── Application ────────────────────────────────────────────────────────
    {
      "label": "Application : lancer en développement",
      "detail": "L'app complète, Rust compris, rechargement à chaud.",
      "icon": { "id": "rocket", "color": "terminal.ansiCyan" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run tauri dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Application : lancer le front seul (navigateur)",
      "detail": "Vite sur localhost:1420, sans le Rust. Les scans échouent.",
      "icon": { "id": "browser", "color": "terminal.ansiCyan" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Application : construire un .exe d'essai (local, non signé)",
      "detail": "Pour l'essayer sur ta machine. Ne peut pas servir de mise à jour. 10 à 20 min.",
      "icon": { "id": "package", "color": "terminal.ansiCyan" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      // `createUpdaterArtifacts` est coupé pour cette construction-là, et
      // seulement pour elle. La clé privée de signature n'existe que comme
      // secret GitHub : en la réclamant, la tâche finissait sur une erreur et
      // un code de sortie 1, alors que l'installeur était produit et que son
      // libellé annonce « non signé ». La release, elle, garde la
      // configuration du dépôt et signe pour de bon.
      "args": [
        "-lc",
        "npm run tauri build -- --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },

    // ── Tests ──────────────────────────────────────────────────────────────
    {
      "label": "Tests : les 254 tests unitaires",
      "detail": "TypeScript puis Rust. 8 s. Tâche de test par défaut.",
      "icon": { "id": "beaker", "color": "terminal.ansiGreen" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm test && cd src-tauri && cargo test --lib"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Tests : TypeScript seulement (204 cas)",
      "detail": "Vitest, une fois. 6 s.",
      "icon": { "id": "beaker", "color": "terminal.ansiGreen" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Tests : TypeScript en surveillance",
      "detail": "Rejoue à chaque sauvegarde. À laisser tourner.",
      "icon": { "id": "eye", "color": "terminal.ansiGreen" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run test:watch"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Tests : Rust seulement (50 cas)",
      "detail": "Scans, registre, désinstalleur, icônes. 1 s.",
      "icon": { "id": "beaker", "color": "terminal.ansiGreen" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "cd src-tauri && cargo test --lib"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"],
      "group": "test"
    },
    {
      "label": "Tests : parcours filmés (7 cas)",
      "detail": "Ouvre l'app et la traverse. Laisse vidéos et captures. 1 min 30.",
      "icon": { "id": "device-camera-video", "color": "terminal.ansiGreen" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run test:e2e"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Tests : interface Vitest",
      "detail": "Ouvre l'adresse affichée dans le terminal : elle porte un jeton.",
      "icon": { "id": "window", "color": "terminal.ansiGreen" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run test:ui"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Tests : interface Playwright",
      "detail": "Rejoue un parcours pas à pas. Pour en écrire un nouveau.",
      "icon": { "id": "window", "color": "terminal.ansiGreen" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run test:e2e:ui"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "group": "test"
    },

    // ── Rapports ───────────────────────────────────────────────────────────
    {
      "label": "Rapport : les 261 tests, films compris",
      "detail": "Joue les trois suites et ouvre le rapport HTML. 2 min.",
      "icon": { "id": "graph", "color": "terminal.ansiMagenta" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": [
        "-lc",
        "npm run test:rapport:tout; code=$?; explorer.exe \"$(cygpath -w \"$PWD/rapport-tests.html\")\" >/dev/null 2>&1; exit $code"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Rapport : rapide, sans rejouer les films",
      "detail": "Unitaires seulement, mais montre les derniers films connus. 8 s.",
      "icon": { "id": "graph", "color": "terminal.ansiMagenta" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": [
        "-lc",
        "npm run test:rapport; code=$?; explorer.exe \"$(cygpath -w \"$PWD/rapport-tests.html\")\" >/dev/null 2>&1; exit $code"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Rapport : ouvrir le dossier des films",
      "detail": "L'Explorateur le cache : son nom commence par un point.",
      "icon": { "id": "folder-opened", "color": "terminal.ansiMagenta" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": [
        "-lc",
        "test -d .rapports/e2e/artefacts && explorer.exe \"$(cygpath -w \"$PWD/.rapports/e2e/artefacts\")\" || echo 'Aucun artefact : lance d abord les parcours filmes.'"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },

    // ── Qualité ────────────────────────────────────────────────────────────
    {
      "label": "Qualité : tout vérifier avant de pousser",
      "detail": "Exactement ce que joue la CI. 1 min.",
      "icon": { "id": "verified", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": [
        "-lc",
        "npm run typecheck && npm run lint && npm run format:check && cd src-tauri && cargo fmt --check && cargo clippy --lib --all-targets -- -D warnings"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$tsc", "$rustc"]
    },
    {
      "label": "Qualité : vérifier les types (TypeScript)",
      "detail": "tsc sans produire de fichiers.",
      "icon": { "id": "symbol-type-parameter", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run typecheck"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Qualité : chercher les défauts (ESLint)",
      "detail": "Le moindre avertissement fait échouer, comme sur la CI.",
      "icon": { "id": "search", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run lint"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Qualité : corriger ce qui peut l'être (ESLint)",
      "detail": "Modifie les fichiers.",
      "icon": { "id": "wrench", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run lint:fix"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Qualité : remettre en forme (Prettier)",
      "detail": "Modifie les fichiers.",
      "icon": { "id": "symbol-ruler", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run format"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Qualité : clippy et rustfmt (Rust)",
      "detail": "Le moindre avertissement fait échouer.",
      "icon": { "id": "symbol-ruler", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": [
        "-lc",
        "cd src-tauri && cargo fmt --check && cargo clippy --lib --all-targets -- -D warnings"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"]
    },

    // ── Documentation et publication ───────────────────────────────────────
    {
      "label": "Documentation : refaire les captures du README",
      "detail": "Photographie six vues et filme le voyage. Le GIF demande ffmpeg.",
      "icon": { "id": "device-camera", "color": "terminal.ansiBlue" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run captures"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Publication : publier la version aux utilisateurs",
      "detail": "Pose le tag, GitHub construit et signe, les copies installées se mettent à jour. Sans retour arrière.",
      "icon": { "id": "tag", "color": "terminal.ansiRed" },
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": [
        "-lc",
        "TAG=${input:tagDeVersion} && git tag $TAG && git push origin $TAG && echo \"Tag $TAG poussé. Suivi : https://github.com/ap7816/Cassini/actions\""
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "tagDeVersion",
      "type": "promptString",
      "description": "Version à publier, préfixée d'un v. Doit correspondre à package.json, tauri.conf.json et Cargo.toml.",
      "default": "v6.1.0"
    }
  ]
}
