{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cassini: Dev (web)",
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Cassini: Dev (tauri)",
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run tauri dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Cassini: Build (tauri)",
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run tauri build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Cassini: Lint",
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run lint"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Cassini: Format (write)",
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run format"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Cassini: Check (typecheck+lint+format:check)",
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": ["-lc", "npm run typecheck && npm run lint && npm run format:check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Cassini: Release (tag + push)",
      "type": "shell",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": [
        "-lc",
        "TAG=${input:releaseTag} && git tag $TAG && git push origin $TAG && echo \"Release $TAG pushed — build en cours sur GitHub Actions\""
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "releaseTag",
      "type": "promptString",
      "description": "Nom du tag de release (ex: v0.8.0)",
      "default": "v0.8.0"
    }
  ]
}
