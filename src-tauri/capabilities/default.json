{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "steam://open/**"
        },
        {
          "url": "steam://rungameid/**"
        },
        {
          "url": "steam://install/**"
        },
        {
          "url": "steam://uninstall/**"
        },
        {
          "url": "steam://store/**"
        },
        {
          "url": "com.epicgames.launcher://**"
        },
        {
          "url": "battlenet://**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "C:/Program Files (x86)/Epic Games/Launcher/Portal/Binaries/Win64/EpicGamesLauncher.exe"
        },
        {
          "path": "C:/Program Files/Epic Games/Launcher/Portal/Binaries/Win64/EpicGamesLauncher.exe"
        },
        {
          "path": "C:/Program Files (x86)/Battle.net/Battle.net.exe"
        },
        {
          "path": "C:/Program Files/Battle.net/Battle.net.exe"
        },
        {
          "path": "C:/Riot Games/Riot Client/RiotClientServices.exe"
        },
        {
          "path": "C:/Program Files/Riot Games/Riot Client/RiotClientServices.exe"
        },
        {
          "path": "C:/Program Files (x86)/Riot Games/Riot Client/RiotClientServices.exe"
        },
        {
          "path": "C:/Program Files/Rockstar Games/Launcher/Launcher.exe"
        },
        {
          "path": "C:/Program Files (x86)/Rockstar Games/Launcher/Launcher.exe"
        },
        {
          "path": "C:/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/UbisoftConnect.exe"
        },
        {
          "path": "C:/Program Files/Ubisoft/Ubisoft Game Launcher/UbisoftConnect.exe"
        },
        {
          "path": "C:/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/Uplay.exe"
        },
        {
          "path": "C:/Program Files/Hypixel Studios/Hytale Launcher/hytale-launcher.exe"
        }
      ]
    },
    "log:default",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "updater:default",
    "store:default",
    "core:event:default",
    "core:webview:allow-clear-all-browsing-data",
    "core:window:allow-hide",
    "core:window:allow-destroy"
  ]
}