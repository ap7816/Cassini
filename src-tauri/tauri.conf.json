{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cassini",
  "version": "6.0.2",
  "identifier": "com.anton.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cassini",
        "width": 1200,
        "height": 750,
        "minWidth": 800,
        "minHeight": 550,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost https://*.steamstatic.com https://*.steamgriddb.com https://*.mzstatic.com https://*.dzcdn.net https://coverartarchive.org https://*.archive.org; media-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$AUDIO/**",
            "$APPDATA/**",
            "$APPLOCALDATA/**"
          ],
          "deny": [
            "$HOME/.ssh/**",
            "$HOME/.aws/**",
            "$HOME/.gnupg/**",
            "$HOME/.config/**",
            "$APPDATA/Microsoft/Crypto/**",
            "$HOME/AppData/Roaming/Microsoft/Crypto/**",
            "$HOME/AppData/Local/Microsoft/Credentials/**",
            "$HOME/AppData/Roaming/Microsoft/Credentials/**",
            "$HOME/**/*.key",
            "$HOME/**/*.pem",
            "$HOME/**/*.pfx"
          ]
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3QjgwQjRGNDJERENDRkEKUldUNnpOMUNUd3U0NTlQSWIwajVOd2FFUGI5Um1oUXIycWhNTzh2ck9hcHFQVmsvcUVaeTZSK3YK",
      "endpoints": [
        "https://github.com/ap7816/Cassini/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
