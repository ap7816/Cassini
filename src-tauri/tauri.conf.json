{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcHive",
  "version": "1.1.1",
  "identifier": "com.anton.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArcHive",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3QjgwQjRGNDJERENDRkEKUldUNnpOMUNUd3U0NTlQSWIwajVOd2FFUGI5Um1oUXIycWhNTzh2ck9hcHFQVmsvcUVaeTZSK3YK",
      "endpoints": [
        "https://raw.githubusercontent.com/apoumier/ArcHive-updates/main/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
